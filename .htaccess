# Eliza A. Penn — Apache config
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # If the site lives in a subfolder, set RewriteBase to it, e.g. RewriteBase /v2/
  # RewriteBase /

  # One canonical address: https://afterdarkromance.com (no www)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Never serve code, content files, server-only storage or tools directly
  RewriteRule ^(app|content|storage|tools)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]

  # Everything that is not a real file goes through the front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(md|lock|sh|sql|log|tmp)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|jpg|jpeg|png|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
